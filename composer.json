{
    "name": "nurbekjummayev/laravel-media-api",
    "description": "Standalone media/file upload API for Laravel — upload once, get an id, link it from each model's own table. Private storage with token access and orphan cleanup.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nurbek Jummayev",
            "email": "jummayevnurbek279@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "nurbekjummayev/laravel-api-response-helpers": "^1.2",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "NurbekJummayev\\LaravelMediaApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NurbekJummayev\\LaravelMediaApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NurbekJummayev\\LaravelMediaApi\\MediaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
